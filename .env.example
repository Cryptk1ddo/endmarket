# =============================================================================
# ARTWATER / HYDRA — Environment Variables
# Copy to .env and fill in secrets before running
# =============================================================================

# -----------------------------------------------------------------------------
# POSTGRES (Docker)
# Local dev: use connection string with your macOS username, no password
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=artwater_dev

# Local dev (Homebrew) — replace 'daniel' with your macOS username
DATABASE_URL_MEDUSA=postgresql://daniel@localhost:5432/artwater_medusa
DATABASE_URL_STRAPI=postgresql://daniel@localhost:5432/artwater_strapi

# Production (Docker Compose)
# DATABASE_URL_MEDUSA=postgresql://artwater:artwater_dev@localhost:5432/artwater_medusa
# DATABASE_URL_STRAPI=postgresql://artwater:artwater_dev@localhost:5432/artwater_strapi

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# MEILISEARCH
# -----------------------------------------------------------------------------
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=artwater_meili_dev
MEILI_ENV=development

# -----------------------------------------------------------------------------
# MEDUSA v2
# Generate: openssl rand -base64 32
# -----------------------------------------------------------------------------
MEDUSA_JWT_SECRET=CHANGE_ME_generate_with_openssl
MEDUSA_COOKIE_SECRET=CHANGE_ME_generate_with_openssl

# Medusa Admin
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_BACKEND_URL=http://localhost:9000

# -----------------------------------------------------------------------------
# STRAPI v5
# Generate APP_KEYS: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
STRAPI_APP_KEYS=CHANGE_ME,CHANGE_ME,CHANGE_ME,CHANGE_ME
STRAPI_API_TOKEN_SALT=CHANGE_ME_generate_with_openssl
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME_generate_with_openssl
STRAPI_JWT_SECRET=CHANGE_ME_generate_with_openssl
STRAPI_URL=http://localhost:1337

# Read-only API token (created via Strapi admin after first run)
STRAPI_API_TOKEN=

# Admin token for seeding (generate in Strapi admin → Settings → API Tokens, type: Full access)
STRAPI_ADMIN_TOKEN=

# -----------------------------------------------------------------------------
# NEXT.JS WEB APP
# -----------------------------------------------------------------------------
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
NEXT_PUBLIC_MEILISEARCH_URL=http://localhost:7700
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=  # Restricted search-only key from Meili admin

# Revalidation secret for ISR webhooks from Medusa/Strapi
REVALIDATION_SECRET=CHANGE_ME_generate_with_openssl

# -----------------------------------------------------------------------------
# CLOUDFLARE R2 (Media Storage)
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=artwater-media
R2_PUBLIC_URL=https://media.tendmarket.ru

# -----------------------------------------------------------------------------
# PAYMENT PROVIDERS
# -----------------------------------------------------------------------------
# ЮKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://tendmarket.ru/order/success

# T-Bank (Tinkoff)
TBANK_TERMINAL_KEY=
TBANK_SECRET_KEY=
TBANK_RETURN_URL=https://tendmarket.ru/order/success

# -----------------------------------------------------------------------------
# ANALYTICS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_YANDEX_METRIKA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# -----------------------------------------------------------------------------
# EMAIL (Transactional)
# -----------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@tendmarket.ru

# Resend (preferred for transactional email)
RESEND_API_KEY=re_CHANGE_ME
RESEND_AUDIENCE_ID=
EMAIL_NOTIFY=orders@tendmarket.ru

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION URLS
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FRONTEND_URL=https://tendmarket.ru
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME

# Stripe (Phase 3 — add after payment provider configured in Medusa)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
