# Self-hosted production template for docker-compose.hosting.yml
# Copy to .env.hosting and replace every placeholder before first deploy.
# Note: the current frontend content/SEO still hardcodes endmarket.ru in many pages.
# If your launch domain is different, replace those app references before go-live.

PRIMARY_DOMAIN=your-domain.tld
ACME_EMAIL=ops@your-domain.tld

POSTGRES_USER=artwater
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_MEDUSA_DB=artwater_medusa
POSTGRES_STRAPI_DB=artwater_strapi

MEILI_MASTER_KEY=CHANGE_ME_meili_master_key

MEDUSA_JWT_SECRET=CHANGE_ME_medusa_jwt_secret
MEDUSA_COOKIE_SECRET=CHANGE_ME_medusa_cookie_secret

STRAPI_APP_KEYS=CHANGE_ME_key_1,CHANGE_ME_key_2,CHANGE_ME_key_3,CHANGE_ME_key_4
STRAPI_API_TOKEN_SALT=CHANGE_ME_strapi_api_token_salt
STRAPI_ADMIN_JWT_SECRET=CHANGE_ME_strapi_admin_jwt_secret
STRAPI_JWT_SECRET=CHANGE_ME_strapi_jwt_secret
STRAPI_API_TOKEN=CHANGE_ME_read_only_token

NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_CHANGE_ME_publishable_key
NEXT_PUBLIC_MEILISEARCH_SEARCH_KEY=CHANGE_ME_search_only_key
REVALIDATION_SECRET=CHANGE_ME_revalidation_secret

YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM=Store <orders@your-domain.tld>
EMAIL_NOTIFY=orders@your-domain.tld

OPENAI_API_KEY=
NEXT_PUBLIC_YANDEX_METRIKA_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=